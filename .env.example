# ============================================================================
# NATU · Variables de entorno
# ============================================================================
# Copia este archivo como .env.local para desarrollo local y configura las
# mismas variables en Vercel (Project Settings → Environment Variables).
#
# Las variables NEXT_PUBLIC_* son visibles en el navegador: usa únicamente la
# ANON KEY pública de Supabase. NUNCA pongas aquí la service_role key.
# ============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY_PUBLICA

# Opcional: URL pública usada para los enlaces de recuperación de contraseña
# y para el QR del sensor móvil (/api/info).
# Si no se define, se usa el origen del navegador (window.location.origin).
# NEXT_PUBLIC_SITE_URL=https://natu-sismos.vercel.app
